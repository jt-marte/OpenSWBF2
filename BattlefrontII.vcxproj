  <Target Name="BuildLuaLvls" AfterTargets="Build" DependsOnTargets="StageGameData" Condition="'$(SWBF2_GAMEDATA)' != '' and '$(SWBF2_NOSTAGE)' != 'true'">
    <Exec WorkingDirectory="$(ProjectDir)" Command="&quot;$(OutDir)LuaCompiler.exe&quot; lvl --index &quot;data\scripts\index.json&quot; --gamedata &quot;$(SWBF2_GAMEDATA)&quot; --out-dir &quot;$(OutDir)data\_lvl_pc&quot;" />
  </Target>
  <Target Name="StageGameData" AfterTargets="Build" Condition="'$(SWBF2_GAMEDATA)' != '' and '$(SWBF2_NOSTAGE)' != 'true'">
    <Exec WorkingDirectory="$(ProjectDir)" Command="&quot;$(OutDir)LuaCompiler.exe&quot; stage --retail &quot;$(SWBF2_GAMEDATA)&quot; --out &quot;$(OutDir).&quot;" />
    <ItemGroup>
      <GameDataFile Include="$(SWBF2_GAMEDATA)\binkw32.dll" Condition="Exists('$(SWBF2_GAMEDATA)\binkw32.dll')" />
      <GameDataFile Include="$(SWBF2_GAMEDATA)\Galaxy.dll" Condition="Exists('$(SWBF2_GAMEDATA)\Galaxy.dll')" />
      <GameDataFile Include="$(SWBF2_GAMEDATA)\GalaxyPeer.dll" Condition="Exists('$(SWBF2_GAMEDATA)\GalaxyPeer.dll')" />
      <GameDataFile Include="$(SWBF2_GAMEDATA)\steam_api.dll" Condition="Exists('$(SWBF2_GAMEDATA)\steam_api.dll')" />
      <GameDataFile Include="$(SWBF2_GAMEDATA)\unicows.dll" Condition="Exists('$(SWBF2_GAMEDATA)\unicows.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(GameDataFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(OutDir)steam_appid.txt" Lines="6060" Overwrite="true" />
    <MakeDir Directories="$(OutDir)SaveGames" />
  </Target>
