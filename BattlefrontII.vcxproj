  <PropertyGroup Condition="'$(SWBF2_GAMEDATA)' == ''">
    <_SteamSWBF2>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 6060', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</_SteamSWBF2>
